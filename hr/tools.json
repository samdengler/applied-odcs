[
  {
    "name": "get_profile",
    "description": "Show an employee's profile: name, work email, home address, personal phone, and salary.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee id, for example alice."
        }
      },
      "required": [
        "employeeId"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "workEmail": {
          "type": "string"
        },
        "homeAddress": {
          "type": "object",
          "properties": {
            "line1": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          }
        },
        "personalPhone": {
          "type": "string"
        },
        "salary": {
          "type": "number"
        },
        "bankAccount": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "update_address",
    "description": "Record that an employee moved.  The HR system changes their home address, tells payroll so tax withholding follows the move, and screens the change for payroll diversion.  Returns the address change.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "description": "The employee who moved, for example alice."
        },
        "address": {
          "type": "object",
          "properties": {
            "line1": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          },
          "description": "The new home address, every line.",
          "required": [
            "line1",
            "city",
            "postalCode",
            "country"
          ]
        }
      },
      "required": [
        "employeeId",
        "address"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "changeId": {
          "type": "string"
        },
        "employeeId": {
          "type": "string"
        },
        "homeAddress": {
          "type": "object",
          "properties": {
            "line1": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "country": {
              "type": "string"
            }
          }
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        },
        "payrollNotified": {
          "type": "boolean"
        },
        "fraudScore": {
          "type": "number"
        }
      }
    }
  }
]
