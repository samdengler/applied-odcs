// Every verb takes a User: the employee calling the tools.

// The request leg's verbs, one per business intent. Each names the
// employee's record; the call names the employee in context.input.
action ViewProfile appliesTo {
  principal: [User],
  resource: [Employee],
  context: {
    input?: {
      employeeId?: User
    }
  }
};

action UpdateAddress appliesTo {
  principal: [User],
  resource: [Employee],
  context: {
    input?: {
      employeeId?: User
    }
  }
};

// One per line update_address sends, named at its Employee path.
action UpdateAddressField appliesTo {
  principal: [User],
  resource: [Employee],
  context: {
    field?: String,
    input?: {
      employeeId?: User
    }
  }
};

// The response leg's verbs, two per model: the record, then each field.
action ReadEmployee appliesTo {
  principal: [User],
  resource: [Employee]
};

action ReadEmployeeField appliesTo {
  principal: [User],
  resource: [Employee],
  context: {
    field?: String
  }
};

action ReadAddressChange appliesTo {
  principal: [User],
  resource: [AddressChange]
};

action ReadAddressChangeField appliesTo {
  principal: [User],
  resource: [AddressChange],
  context: {
    field?: String
  }
};
