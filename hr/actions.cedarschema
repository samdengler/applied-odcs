// Every verb takes a User: the employee calling the tools.

// The request leg's verb for reading one record. The response leg
// decides the read again with ReadEmployee, on the record the API
// returns.
action LookupEmployee appliesTo {
  principal: [User],
  resource: [Employee],
  context: {
    input?: {
      employeeId?: User
    }
  }
};

action ReadEmployee appliesTo {
  principal: [User],
  resource: [Employee]
};

action ReadEmployeeField appliesTo {
  principal: [User],
  resource: [Employee],
  context: {
    field?: String
  }
};

action UpdateEmployee appliesTo {
  principal: [User],
  resource: [Employee],
  context: {
    input?: {
      employeeId?: User
    }
  }
};

action UpdateEmployeeField appliesTo {
  principal: [User],
  resource: [Employee],
  context: {
    field?: String,
    input?: {
      employeeId?: User
    }
  }
};
